# Frontend API target. Keep broker/API credentials out of cloud-hosted UI env files.
VITE_API_BASE_URL=http://localhost:7070
VITE_PRIMARY_ACCOUNT_EMAIL=local@example.invalid

# Optional backend fallback for routes where no email query parameter is supplied.
TRADINGBOT_DEFAULT_ACCOUNT_EMAIL=local@example.invalid
TRADINGBOT_BIND_HOST=127.0.0.1
TRADINGBOT_PORT=7070
