[Unit]
Description=Trading Bot Backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tradingbot
Group=tradingbot
WorkingDirectory=/opt/tradingbot/backend
Environment=TRADINGBOT_APP_DIR=/opt/tradingbot/backend
ExecStart=/opt/tradingbot/backend/run-backend-release.sh
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
