# Frontend API target. Keep broker/API credentials out of cloud-hosted UI env files.
VITE_API_BASE_URL=http://localhost:7070
VITE_PRIMARY_ACCOUNT_EMAIL=local@example.invalid

# Optional backend fallback for routes where no email query parameter is supplied.
TRADINGBOT_DEFAULT_ACCOUNT_EMAIL=local@example.invalid
TRADINGBOT_BIND_HOST=127.0.0.1
TRADINGBOT_PORT=7070
TRADINGBOT_SESSION_TTL_SECONDS=43200

# Private first-user bootstrap for a fresh DB/container. Remove or rotate after first launch.
TRADINGBOT_BOOTSTRAP_ADMIN_NAME=Trading Bot Admin
TRADINGBOT_BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
TRADINGBOT_BOOTSTRAP_ADMIN_PASSWORD=change-this-before-launch

# Container runtime frontend target. Point this at the bridge/cloud API URL, not broker secrets.
TRADINGBOT_API_BASE_URL=http://localhost:7070
